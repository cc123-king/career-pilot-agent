# 默认使用 demo：无需 API Key，不产生任何费用。
LLM_PROVIDER=demo

# 使用 OpenAI 时改成 openai，并填写以下两项。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# 使用 DeepSeek 等 OpenAI 兼容接口时改成 compatible，并填写以下三项。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 服务配置
APP_HOST=127.0.0.1
APP_PORT=7860
API_PORT=8000
DATABASE_PATH=data/applications.db

